{
  "displayName": "foto-log-web is returning server errors",
  "combiner": "OR",
  "conditions": [
    {
      "displayName": "More than 10 responses with a 5xx status in 5 minutes",
      "conditionThreshold": {
        "filter": "metric.type=\"run.googleapis.com/request_count\" AND resource.type=\"cloud_run_revision\" AND resource.label.service_name=\"foto-log-web\" AND metric.label.response_code_class=\"5xx\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_SUM",
            "crossSeriesReducer": "REDUCE_SUM",
            "groupByFields": ["resource.label.service_name"]
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 10,
        "duration": "0s",
        "trigger": { "count": 1 }
      }
    }
  ],
  "alertStrategy": { "autoClose": "86400s" },
  "documentation": {
    "mimeType": "text/markdown",
    "content": "Cloud Run service foto-log-web returned more than 10 responses with a 5xx status in 5 minutes. In Logs Explorer, filter on `resource.labels.service_name=\"foto-log-web\" severity>=ERROR`, or open Error Reporting. See docs/infra.md."
  }
}
